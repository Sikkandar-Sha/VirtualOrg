#!/usr/bin/env python3
"""
Score a kit's output against VirtualOrg's ground truth.

VirtualOrg knows what should have been concluded. This reads what your product
concluded and says how close it got: precision and recall per assertion family,
and, for attribution, exactly which of the deliberate traps it fell for.

    ./scripts/score posture.json

The input contract is deliberately small. Anything richer becomes a schema people
argue with instead of a benchmark they run.

    {
      "meta": {"world_seed": 48392, "as_of": "2026-08-21", "scale": 1.0,
               "chaos": 1, "generator_version": "6"},
      "findings":     [{"family": "conflict", "subject_kind": "control", "subject_id": "CTL-017"}],
      "attributions": [{"evidence_id": "EVD-000123", "control_id": "CTL-045"}]
    }

Findings match on the (family, subject_kind, subject_id) triple, never on claim
text: scoring English would make this a string-matching exercise rather than a
measure of whether the right thing was found.
"""
import argparse
import json
import os
import sys

import httpx

# The answer key comes from the Control Center, never from the twins: a kit that
# could fetch its own marking scheme would not be measuring anything. It also means
# this runs against a remote VirtualOrg with nothing installed but httpx.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _dotenv import dotenv as _dotenv          # noqa: E402  one parser, see _dotenv.py

CC = _dotenv("VO_CC_BASE", "") or f"http://127.0.0.1:{_dotenv('VO_CC_PORT', '3000')}"


def pct(n, d):
    return 0.0 if not d else n / d


def fmt(x):
    return f"{x:.3f}"


def fetch(url):
    try:
        r = httpx.get(f"{url}/export/groundtruth", timeout=120)
        r.raise_for_status()
        return r.json()
    except Exception as e:
        print(f"Cannot read ground truth from {url}: {type(e).__name__}: {e}", file=sys.stderr)
        print("Is the Control Center running? Set VO_CC_BASE if it is not on :3000.",
              file=sys.stderr)
        sys.exit(2)


def load_aliases(gt):
    """Map every identifier a kit could have seen to the canonical world id.

    A kit never sees `CTL-017`; it sees `C-017` from the GRC API, or
    `lt-4069.corp.local` from the CMDB, or an agent uuid from the EDR. Resolving those
    back is the same entity-resolution problem the kit itself had to solve, so the
    scorer does it rather than demanding ids the kit has no way to know.
    """
    return {(a["kind"].lower(), a["alias"]): a["id"] for a in gt["aliases"]}


def resolve(alias, kind, value):
    return alias.get((str(kind).strip().lower(), str(value).strip().lower()), value)


def load_truth(gt):
    truth, claims, reach = {}, {}, {}
    for r in gt["expectations"]:
        key = (r["family"], r["subject_kind"], r["subject_id"])
        truth.setdefault(key, []).append(r["id"])
        claims.setdefault(key, []).append(r["claim"])
        # A subject is reachable if ANY of its rows is: one supporting claim is enough
        # for a kit to reach the conclusion.
        reach[key] = reach.get(key, False) or r.get("reachable", True)
    # Keyed by evidence id AND by the source record it came from, because a kit sees
    # `ALR-000123` from Splunk and cannot know the evidence row is `EVD-000456`. Both
    # keys resolve to the SAME canonical row id, so claiming one link under both
    # spellings is one claim rather than two. Counting it twice let recall exceed 1.
    ev = {}
    for r in gt["evidence"]:
        row = (r["id"], r["control_id"], r["is_trap"], r.get("reachable", True))
        ev[r["id"]] = row
        if r.get("source_ref"):
            ev.setdefault(r["source_ref"], row)
    return truth, claims, ev, reach


def check_world(meta, live):
    """Refuse to score against a different world. A number produced from world A and
    compared to the answer key for world B is worse than no number at all."""
    # All five, because scale and chaos change the world as surely as the seed does.
    want = {"world_seed": "seed", "as_of": "as_of", "scale": "scale",
            "chaos": "chaos", "generator_version": "generator_version"}
    bad = []
    if not meta:
        return ["the posture carries no `meta` block, so there is no way to tell which "
                "world produced it"]
    for given, key in want.items():
        if given not in meta:
            bad.append(f"`meta.{given}` is missing; the loaded world has {key}={live.get(key)}")
        elif str(meta[given]) != str(live.get(key)):
            bad.append(f"{given}={meta[given]} but the loaded world has {key}={live.get(key)}")
    return bad


def main():
    ap = argparse.ArgumentParser(description="Score a posture against VirtualOrg ground truth")
    ap.add_argument("posture", help="JSON file produced by the kit under test")
    ap.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    ap.add_argument("--traps", type=lambda v: max(0, int(v)), default=10, help="how many traps to list (default 10)")
    ap.add_argument("--force", action="store_true",
                    help="score even if the world does not match (do not do this)")
    a = ap.parse_args()

    try:
        with open(a.posture) as fh:
            posture = json.load(fh)
    except FileNotFoundError:
        print(f"no such file: {a.posture}", file=sys.stderr)
        return 2
    except json.JSONDecodeError as e:
        print(f"{a.posture} is not valid JSON: {e}", file=sys.stderr)
        return 2
    if not isinstance(posture, dict):
        print(f"{a.posture} must be a JSON object with `meta`, `findings` and "
              f"`attributions`; found {type(posture).__name__}.", file=sys.stderr)
        return 2
    for _field in ("findings", "attributions"):
        _v = posture.get(_field, [])
        if not isinstance(_v, list):
            print(f"`{_field}` must be a list, found {type(_v).__name__}.", file=sys.stderr)
            return 2
        for _i, _item in enumerate(_v):
            if not isinstance(_item, dict):
                print(f"`{_field}[{_i}]` must be an object, found "
                      f"{type(_item).__name__}.", file=sys.stderr)
                return 2
    gt = fetch(CC)
    live = gt["world"]
    mismatch = check_world(posture.get("meta", {}), live)
    if mismatch and not a.force:
        print("This posture was not produced from the loaded world:", file=sys.stderr)
        for m in mismatch:
            print(f"  {m}", file=sys.stderr)
        print("\nScoring it would compare answers to the wrong answer key. "
              "Regenerate, or pass --force if you truly mean to.", file=sys.stderr)
        return 2

    truth, claims, evidence, reach = load_truth(gt)

    # ---- findings
    alias = load_aliases(gt)
    claimed, unresolved = set(), []
    for i, f in enumerate(posture.get("findings", [])):
        fam = str(f.get("family") or "").strip().lower()
        if not fam:
            print(f"finding {i} has no `family`; every finding needs one of "
                  f"absence, conflict, degradation.", file=sys.stderr)
            return 2
        # Normalise the kind exactly as the identifier is normalised. Doing one and
        # not the other made "Asset" score zero against "asset" and then report the
        # subject as unresolvable, which it was not.
        kind = str(f.get("subject_kind") or "").strip().lower()
        raw = f.get("subject_id")
        canon = resolve(alias, kind, raw)
        if canon == raw and (kind, str(raw).strip().lower()) not in alias:
            if fam != "attribution":
                unresolved.append(f"{kind}/{raw}")
        claimed.add((fam, kind, canon))
    # `attribution` expectations describe the decoys, and are scored properly in the
    # Attribution section below. Counting them here as well would double-count and
    # depress recall for a reason that is not the kit's doing.
    SCORED_AS_FINDINGS = {"absence", "conflict", "degradation"}
    truth = {k: v for k, v in truth.items() if k[0] in SCORED_AS_FINDINGS}
    # A claim under a family that does not exist is wrong, not invisible. Dropping
    # these silently meant precision could not be damaged by any amount of garbage.
    ignored_attribution = sum(1 for k in claimed if k[0] == "attribution")
    unknown_family = sorted({k[0] for k in claimed
                             if k[0] not in SCORED_AS_FINDINGS and k[0] != "attribution"},
                            key=str)
    bogus = {k for k in claimed if k[0] in unknown_family}
    claimed = {k for k in claimed if k[0] in SCORED_AS_FINDINGS}
    fams = sorted({k[0] for k in truth} | {k[0] for k in claimed if k[0]})
    rows, totals = [], {"tp": 0, "fp": 0, "fn": 0}
    for fam in fams:
        t = {k for k in truth if k[0] == fam}
        c = {k for k in claimed if k[0] == fam}
        tp, fp, fn = len(t & c), len(c - t), len(t - c)
        totals["tp"] += tp; totals["fp"] += fp; totals["fn"] += fn
        rows.append({"family": fam, "expected": len(t), "claimed": len(c),
                     "correct": tp, "spurious": fp, "missed": fn,
                     "precision": pct(tp, tp + fp), "recall": pct(tp, tp + fn)})
    if bogus:
        totals["fp"] += len(bogus)
        rows.append({"family": "unrecognised", "expected": 0, "claimed": len(bogus),
                     "correct": 0, "spurious": len(bogus), "missed": 0,
                     "precision": 0.0, "recall": 0.0})

    # ---- attribution
    a_tp = a_fp = 0
    traps_taken, unknown, duplicates = [], 0, 0
    contradictions = 0
    unreachable_correct = 0
    scored_ev = {}
    # Collect first, score afterwards. Scoring as we go meant a contradiction
    # discovered late could not retract the claim already counted, so the same
    # posture scored differently depending on the order of its array.
    for x in posture.get("attributions", []):
        eid, cid = x.get("evidence_id"), x.get("control_id")
        if eid not in evidence:
            unknown += 1
            continue
        canonical, true_cid, is_trap, reachable = evidence[eid]
        cid = resolve(alias, "control", cid)   # a kit emits C-011, not CTL-011
        if canonical in scored_ev:
            if cid in scored_ev[canonical]:
                duplicates += 1      # the same link, named a second way
            else:
                scored_ev[canonical].add(cid)
            continue
        scored_ev[canonical] = {cid}

    for canonical, cids in scored_ev.items():
        _, true_cid, is_trap, reachable = evidence[canonical]
        if len(cids) > 1:
            # Two different answers for one row. Which arrived first is not a
            # property of the kit, so neither is credited and the row costs one.
            contradictions += 1
            a_fp += 1
            continue
        cid = next(iter(cids))
        if is_trap:
            if reachable:
                traps_taken.append((canonical, cid, true_cid))
            a_fp += 1
        elif cid != true_cid:
            a_fp += 1
        elif reachable:
            a_tp += 1
        else:
            # correct, but against a link no API exposes, so it cannot count toward a
            # recall measured over reachable links
            unreachable_correct += 1
    # counted from the rows, not from `evidence`, which holds two keys per row
    a_total = sum(1 for r in gt["evidence"] if not r["is_trap"])
    a_reach = sum(1 for r in gt["evidence"] if not r["is_trap"] and r.get("reachable", True))
    # Same correction as the recall denominator: a trap on an alert Splunk never
    # returns cannot be taken, so counting it makes the score look better than it is.
    n_traps = sum(1 for r in gt["evidence"] if r["is_trap"] and r.get("reachable", True))
    a_fn = max(0, a_reach - a_tp)

    result = {
        "world": live,
        "findings": {"by_family": rows,
                     "precision": pct(totals["tp"], totals["tp"] + totals["fp"]),
                     "recall": pct(totals["tp"], totals["tp"] + totals["fn"]), **totals},
        "unresolved_subjects": unresolved,
        "attribution": {"claimed": len(posture.get("attributions", [])),
                        "scored": len(scored_ev), "duplicates_ignored": duplicates,
                        "contradictions": contradictions,
                        "correct": a_tp, "wrong": a_fp, "missed": a_fn,
                        "correct_but_unreachable": unreachable_correct,
                        "true_links": a_total, "reachable_links": a_reach,
                        "traps_total": n_traps, "traps_taken": len(traps_taken),
                        "unknown_evidence_ids": unknown,
                        "precision": pct(a_tp, a_tp + a_fp),
                        "recall": pct(a_tp, a_reach)},
    }
    result["world_mismatch"] = mismatch
    result["forced"] = bool(mismatch and a.force)
    if a.json:
        print(json.dumps(result, indent=2))
        return 0

    print("VirtualOrg score\n")
    print(f"  world  seed={live.get('seed')} as_of={live.get('as_of')} "
          f"chaos={live.get('chaos')} generator_version={live.get('generator_version')}")
    if mismatch:
        print("  WARNING: forced past a world mismatch; these numbers mean nothing")
    print("\nFindings")
    print("  Counted by distinct (family, subject_kind, subject_id), which is what a kit")
    print("  can express. The ground-truth catalogue counts expectation rows, and one")
    print("  subject can carry several, so its totals are higher. Attribution is scored")
    print("  separately, below.")
    print(f"  {'family':<13}{'expected':>9}{'claimed':>9}{'correct':>9}"
          f"{'missed':>8}{'spurious':>10}{'precision':>11}{'recall':>9}")
    for r in rows:
        print(f"  {r['family']:<13}{r['expected']:>9}{r['claimed']:>9}{r['correct']:>9}"
              f"{r['missed']:>8}{r['spurious']:>10}{fmt(r['precision']):>11}{fmt(r['recall']):>9}")
    f = result["findings"]
    print(f"  {'all':<13}{f['tp'] + f['fn']:>9}{f['tp'] + f['fp']:>9}{f['tp']:>9}"
          f"{f['fn']:>8}{f['fp']:>10}{fmt(f['precision']):>11}{fmt(f['recall']):>9}")
    _unreach = sorted(k for k in truth if not reach.get(k, True))
    if _unreach:
        # Attribution recall has been corrected for reachability since the
        # denominators were fixed. Say the same thing here rather than quietly
        # scoring a kit against conclusions no API supports.
        print(f"  {len(_unreach)} of those subjects are not reachable through any lens, so a")
        print( "  flawless kit cannot claim them. Their evidence exists in the world but")
        print( "  no vendor API exposes it, e.g. privileged group membership held in AD.")

    if ignored_attribution:
        print(f"  {ignored_attribution:,} finding{'' if ignored_attribution == 1 else 's'} in the attribution family {'is' if ignored_attribution == 1 else 'are'} not scored")
        print( "  here. Attribution is scored from the `attributions` array, below.")

    at = result["attribution"]
    print(f"\nAttribution")
    print(f"  {at['claimed']:,} attributions claimed, {at['scored']:,} distinct links scored")
    print(f"  correct {at['correct']:,}   wrong {at['wrong']:,}   missed {at['missed']:,}")
    print(f"  precision {fmt(at['precision'])}   recall {fmt(at['recall'])}")
    print(f"  recall is against the {at['reachable_links']:,} true links whose source record")
    print(f"  a connector can actually retrieve. The world holds {at['true_links']:,} in total;")
    print( "  the rest sit behind control-test history the GRC API never exposes, or on")
    print( "  alerts outside Splunk's retention window or on assets its coverage misses.")
    if at["duplicates_ignored"]:
        print(f"  {at['duplicates_ignored']:,} repeat claims on a link already scored, ignored")
    if at["contradictions"]:
        print(f"  {at['contradictions']:,} links claimed twice naming different controls, "
              f"scored wrong")
    if at["correct_but_unreachable"]:
        print(f"  {at['correct_but_unreachable']:,} correct against links no API exposes, "
              f"excluded from recall")
    print(f"  traps taken {at['traps_taken']} of {at['traps_total']}")
    if at["unknown_evidence_ids"]:
        rate = at["unknown_evidence_ids"] / max(1, at["claimed"])
        print(f"  {at['unknown_evidence_ids']:,} attributions name a source record with no")
        print( "  ground-truth link. Only a sample of alerts was labelled, so these are")
        print( "  neither right nor wrong: they are unscoreable.")
        print(f"  unscoreable rate {rate:.1%} of everything claimed")
        if rate >= 0.5:
            print( "  More than half of this output could not be scored either way. The")
            print( "  precision above describes the minority that could be, and a kit can")
            print( "  raise it by emitting more of what does not count. Read it with that")
            print( "  in mind: on these numbers the kit is guessing more often than not.")
    if unresolved:
        print(f"\n{len(unresolved)} subjects could not be resolved to anything in the world")
        print("  These are scored against the family they were claimed under, like any")
        print("  other finding. Check the identifier you emitted.")
        for u in unresolved[:8]:
            print(f"    {u}")

    if traps_taken:
        print(f"\nTraps taken, first {min(a.traps, len(traps_taken))}")
        print("  These events are not evidence for any control. The decoy each was")
        print("  planted against is drawn from the whole control library, so a trap is")
        print("  not reliably topically adjacent: asserting a link to one means")
        print("  asserting a link the world does not support, which is the failure")
        print("  this environment exists to measure.")
        for eid, said, decoy in traps_taken[:a.traps]:
            print(f"    {eid}  attributed to {said}; this event evidences no control, "
                  f"and {decoy} is the decoy it was planted against")

    missing = [(k, claims[k]) for k in truth if k not in claimed]
    if missing:
        print(f"\nMissed, first 10 of {len(missing)}")
        for (fam, kind, sid), cl in missing[:10]:
            extra = f"  (+{len(cl) - 1} more on this subject)" if len(cl) > 1 else ""
            print(f"    {fam:<12} {kind}/{sid}  {cl[0]}{extra}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
