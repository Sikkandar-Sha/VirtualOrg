# --- world -------------------------------------------------------------------
VO_SEED=48392
VO_AS_OF=2026-08-21          # fixed date => reproducible world
VO_SCALE=1.0                 # 0.2 for a laptop-fast world, 3.0 for volume tests
VO_CHAOS=1                   # 0 pristine | 1 realistic | 2 pathological (DESIGN.md §4.4)                 # 0.2 for a laptop-fast world, 3.0 for volume tests

# --- twins -------------------------------------------------------------------
VO_TOKENS=vo-dev-token       # comma separated; VO_AUTH_MODE=static
VO_AUTH_MODE=static          # static | jwks (jwks = validate against Keycloak)
# Used only when VO_AUTH_MODE=jwks. The issuer is what Keycloak stamps into the
# token; the JWKS URL is where the twin fetches keys from. They differ on purpose.
VO_JWT_ISSUER=http://localhost:8081/realms/virtualorg
VO_JWKS_URL=http://keycloak:8080/realms/virtualorg/protocol/openid-connect/certs
VO_JWT_AUDIENCE=vo-kit       # the client, not "account", which every realm token carries

# Keys the attachment download tokens. Leave blank for a random key per process:
# tokens then last only for that run, which is fine because the attachment
# metadata call issues a current one every time.
VO_EVIDENCE_SECRET=
VO_PROFILE_SERVICENOW=out-of-the-box   # out-of-the-box | lightly-customized | heavily-customized

# --- control center ----------------------------------------------------------
VO_CC_PORT=3000              # host port; change if 3000 is taken on your machine

# --- db ----------------------------------------------------------------------
POSTGRES_USER=vo
POSTGRES_PASSWORD=vo
POSTGRES_DB=world
